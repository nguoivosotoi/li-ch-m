<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_solar_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15"
        android:textColor="#FFFFFF"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_solar_month_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tháng 8, 2024"
        android:textColor="#F5B041"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="2dp"
        android:textAllCaps="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33F5B041"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/widget_lunar_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Âm lịch: 12/7"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="italic" />

</LinearLayout>
